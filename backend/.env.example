# The app reads these from the process environment (it does not load .env files).
# Set them in your shell, or as environment variables / secrets on Render. Never commit a real key.
ANTHROPIC_API_KEY=<API_KEY>
FOYDAPAY_LLM=auto
FOYDAPAY_MODEL=claude-opus-5-5
FOYDAPAY_EFFORT=medium
FOYDAPAY_FALLBACKS=1
